{
  admin off
  auto_https off
}

:3000 {
  # Health check for Caddy itself
  handle /healthz {
    respond "OK" 200
  }

  # Durable streams (LMDB persistence, SSE + long-poll)
  #
  # RS-019: SSE Authentication
  # These stream endpoints currently have no authentication at the Caddy level.
  # Security is enforced via network-level access control:
  #   - In production: Caddy is only reachable from the internal Docker network.
  #     The reverse proxy (handle /api/*) is the sole external entry point,
  #     which routes through the authenticated Bun API server.
  #   - Clients connect to /v1/stream/* only from the browser after authenticating
  #     via the /api/auth/* flow. The session cookie is validated on API endpoints
  #     but not on Caddy stream endpoints directly.
  #
  # To add Caddy-level auth, uncomment and configure forward_auth:
  #   forward_auth localhost:3001 {
  #     uri /api/auth/verify
  #     copy_headers Authorization
  #   }
  #
  # Alternatively, use Caddy's `basicauth` or a JWT plugin for direct validation.
  @streams path /v1/stream /v1/stream/*
  handle @streams {
    durable_streams {
      data_dir {$STREAMS_DATA_DIR:/app/data/streams}
      long_poll_timeout 30s
      sse_reconnect_interval 120s
    }
  }

  # Reverse proxy to Bun API server
  handle /api/* {
    reverse_proxy localhost:3001 {
      flush_interval -1
    }
  }

  # Static files with SPA fallback
  handle {
    root * /app/dist
    encode gzip br
    try_files {path} /index.html
    file_server {
      precompressed gzip br
    }
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
  }
}
