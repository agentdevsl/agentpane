# Agent Sandbox Dockerfile
# Extends the terraform-ai-tools base image with the Claude Agent Runner
#
# theme-04 P0-01 / arch29-W1-C: Runtime references to this image MUST be
# digest-pinned (`<image>@sha256:<digest>`). Tag-only references (`:latest`,
# etc.) are rejected by SandboxConfigService AND by the settings PUT endpoint.
# The default image reference lives in `src/lib/sandbox/types.ts`
# (`SANDBOX_DEFAULTS.image`) and is pinned to the multi-arch OCI index digest
# of the upstream image; this Dockerfile's BASE_IMAGE is pinned the same way.
#
# Usage (build for publishing):
#   docker build -f docker/Dockerfile.agent-sandbox -t ghcr.io/agentdevsl/agent-sandbox:<version> .
#   docker push ghcr.io/agentdevsl/agent-sandbox:<version>
#   # Read the resulting digest and update SANDBOX_DEFAULTS.image:
#   docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/agentdevsl/agent-sandbox:<version>
#
# The image includes:
# - Base terraform-ai-tools environment (Node.js 22, Terraform, Git, jq)
# - Claude Agent Runner for SDK execution
# - ripgrep, fd-find, tree for file operations

# BASE_IMAGE is digest-pinned to prevent supply-chain attacks via mutable tags.
# This is the multi-arch OCI index digest of `srlynch1/terraform-ai-tools:latest`
# resolved via `docker manifest inspect`. To rotate, see SANDBOX_DEFAULTS.image
# in src/lib/sandbox/types.ts for the rotation procedure.
ARG BASE_IMAGE=docker.io/srlynch1/terraform-ai-tools@sha256:c8bb7d79efeebabd9dd91c95a406c204c6ad6e1d8c15359f778929152ef2a974

FROM ${BASE_IMAGE}

# Switch to root for package installation
USER root

# Install additional tools needed by the agent runner
# (jq, terraform, git already included in base image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ripgrep \
    fd-find \
    tree \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Claude Code CLI globally (required by Claude Agent SDK)
# The SDK spawns the CLI process and communicates with it
RUN npm install -g @anthropic-ai/claude-code

# Create directory for agent runner
RUN mkdir -p /opt/agent-runner

# Copy agent runner source and config files
COPY agent-runner/package.json agent-runner/package-lock.json* /opt/agent-runner/
COPY agent-runner/tsconfig.json /opt/agent-runner/
COPY agent-runner/src /opt/agent-runner/src/

# Install dependencies (including devDependencies for build)
WORKDIR /opt/agent-runner
RUN npm install --ignore-scripts

# Build TypeScript to JavaScript
RUN npm run build

# Clean up: remove source files and devDependencies to reduce image size
RUN rm -rf src tsconfig.json && \
    npm prune --production

# Configure git for mounted volumes (prevents "dubious ownership" errors)
RUN git config --system --add safe.directory '*' && \
    git config --system user.email "agent@sandbox.local" && \
    git config --system user.name "AgentPane Sandbox"

# Ensure /workspace exists and is writable by node user
RUN mkdir -p /workspace && chown -R node:node /workspace

# Create .claude directories for SDK (plans, credentials, etc.)
RUN mkdir -p /home/node/.claude/plans && chown -R node:node /home/node/.claude

# Allow node user to use sudo for permission fixes (passwordless)
RUN echo "node ALL=(ALL) NOPASSWD: /bin/chown" >> /etc/sudoers.d/node-chown

# Copy cached skills, agents, and foundations into image.
# These provide fast startup — the entrypoint copies them to /workspace/ if not
# already present. Runtime injection from the DB can override or add newer versions.
COPY docker/skills-cache/ /opt/skills-cache/
COPY docker/agents-cache/ /opt/agents-cache/
COPY docker/foundations-cache/ /opt/foundations-cache/
COPY docker/github-cache/ /opt/github-cache/
COPY docker/dot-agents-cache/ /opt/dot-agents-cache/
COPY docker/claude-config-cache/ /opt/claude-config-cache/

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set working directory back to workspace
WORKDIR /workspace

# Switch to non-root user for security
USER node

# Use entrypoint script to fix permissions, then run command
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]

# Labels
LABEL org.opencontainers.image.title="Agent Sandbox"
LABEL org.opencontainers.image.description="Docker sandbox with Claude Agent Runner, based on terraform-ai-tools"
LABEL org.opencontainers.image.base.name="docker.io/srlynch1/terraform-ai-tools@sha256:c8bb7d79efeebabd9dd91c95a406c204c6ad6e1d8c15359f778929152ef2a974"
