{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/routes/**/*.{ts,tsx}",
    "src/server/**/*.ts",
    "src/services/**/*.ts",
    "src/lib/**/*.ts",
    "scripts/*.ts",
    "drizzle.config.pg.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/app/components/features/agent-topology/mock/**",
    "src/app/components/features/global-settings.tsx",
    "src/app/components/features/session-history/components/index.ts",
    "src/app/components/features/sidebar.tsx",
    "src/app/components/features/task-detail-dialog/task-labels.tsx",
    "src/app/components/features/task-detail-dialog/task-metadata.tsx",
    "src/app/components/features/workflow-designer/NodeInspector.tsx",
    "src/app/components/features/workflow-designer/SaveWorkflowDialog.tsx",
    "src/app/components/features/workflow-designer/TemplatePicker.tsx",
    "src/app/components/ui/claude-icon.tsx",
    "src/app/hooks/use-task-operations.ts",
    "src/app/services/runtime.ts"
  ],
  "ignoreDependencies": [
    "@tanstack/react-start",
    "agent-browser",
    "@aws-sdk/client-sts",
    "@radix-ui/react-popover"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true
}
