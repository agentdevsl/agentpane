{
  "name": "agent-dev-template",
  "version": "1.0.0",
  "description": "Framework-agnostic TypeScript/Node.js web development template with AI-assisted workflows",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun scripts/start-dev.ts",
    "dev:simple": "bun run dev:api & vite",
    "dev:vite": "vite",
    "dev:api": "bun src/server/api.ts",
    "build": "vite build && tsc --noEmit && npm run build:agent-runner",
    "build:agent-runner": "cd agent-runner && npm run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --diagnostic-level=warn --error-on-warnings --max-diagnostics=500 .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "test:ui": "bun scripts/run-ui-tests.ts",
    "test:integration": "vitest --include 'tests/integration/**'",
    "test:k8s": "K8S_INTEGRATION_TESTS=true vitest run --include 'src/lib/sandbox/providers/__tests__/k8s-tmux.integration.test.ts'",
    "test:k8s-e2e": "K8S_E2E=true vitest run tests/e2e/k8s/",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "mutate": "npx stryker run",
    "mutate:state-machines": "npx stryker run --mutate 'src/lib/state-machines/**/machine.ts,src/lib/state-machines/**/guards.ts,src/lib/state-machines/**/actions.ts'",
    "mutate:rbac": "npx stryker run --mutate 'src/services/rbac.service.ts,src/services/rbac-token.service.ts,src/lib/api/auth-middleware.ts,src/lib/api/rbac-middleware.ts'",
    "mutate:security": "npx stryker run --mutate 'src/lib/crypto/server-encryption.ts,src/lib/crypto/token-encryption.ts,src/services/github-token.service.ts'",
    "mutate:orchestration": "npx stryker run --mutate 'src/services/agent/agent-execution.service.ts,src/services/container-agent/plan-approval.service.ts,src/services/task.service.ts,src/lib/agents/stream-handler.ts'",
    "mutate:incremental": "npx stryker run --incremental",
    "semgrep": "semgrep scan --config .semgrep/rules/ src/ agent-runner/src/ packages/ --exclude 'tests/**' --exclude '**/__tests__/**' --exclude '**/*.test.ts' --exclude '**/*.spec.ts' --exclude 'node_modules/**' --exclude 'dist/**' --exclude '.worktrees/**'",
    "semgrep:error": "semgrep scan --config .semgrep/rules/ --severity ERROR --error src/ agent-runner/src/ packages/ --exclude 'tests/**' --exclude '**/__tests__/**' --exclude '**/*.test.ts' --exclude '**/*.spec.ts' --exclude 'node_modules/**' --exclude 'dist/**' --exclude '.worktrees/**'",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.config.pg.ts",
    "db:migrate:sqlite-to-pg": "bun scripts/migrate-sqlite-to-pg.ts",
    "db:check-migration-parity": "bun scripts/check-migration-parity.ts",
    "migrate:run-only": "bun scripts/migrate-run-only.ts",
    "migrate:check-only": "bun scripts/migrate-check-only.ts",
    "docker:pg": "docker compose -f docker/docker-compose.postgres.yml up -d",
    "docker:pg:down": "docker compose -f docker/docker-compose.postgres.yml down",
    "prepare": "echo 'Run: pre-commit install --hook-type pre-commit --hook-type pre-push'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "agent-browser": "0.26.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.7.0",
    "jsdom": "^29.0.2",
    "knip": "^6.11.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.5"
  },
  "keywords": [
    "template",
    "typescript",
    "nodejs",
    "vitest",
    "eslint",
    "ai-assisted"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-sts": "^3.1041.0",
    "@cdktf/hcl2json": "^0.21.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@durable-streams/client": "0.2.3",
    "@durable-streams/server": "0.3.1",
    "@durable-streams/state": "0.2.5",
    "@kubernetes/client-node": "^1.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/db": "0.6.5",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/router-plugin": "^1.167.22",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "12.10.2",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "cron-parser": "^5.5.0",
    "dockerode": "^4.0.10",
    "dompurify": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.11.1",
    "hono": "^4.12.14",
    "octokit": "^5.0.5",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.8",
    "vite-tsconfig-paths": "^6.1.1",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  },
  "overrides": {
    "@types/node": "^25.6.0",
    "protobufjs": "^7.5.5"
  },
  "resolutions": {
    "protobufjs": "^7.5.5"
  }
}
